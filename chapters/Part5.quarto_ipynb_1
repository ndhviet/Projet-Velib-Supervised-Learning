    "\n",
    "# Prévision pour le dernier relevé\n",
    "\n",
    "Les modèles retenus en Partie 3 sont appliqués au dernier relevé disponible (8 octobre 2026, 20 h 15 UTC) : pour chaque station, on estime la probabilité d'avoir moins de deux vélos dans 30 et 60 minutes. Une station est en alerte si cette probabilité dépasse le seuil choisi sur la validation. Il s'agit d'une photographie à un instant donné, pas d'une statistique générale."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0001d0de",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| echo: false\n",
    "import os\n",
    "import joblib\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from velib_utils import (load_raw_dt, pipeline_horizon, predict_now, top_alertes,\n",
    "                         summary_predictions, plot_predictions_zone,\n",
    "                         plot_predictions_commune, map_predictions_folium,plot_ap_ci,\n",
    "                         precision_at_recall)\n",
    "\n",
    "raw = load_raw_dt()\n",
    "HORIZONS = (30, 60)\n",
    "os.makedirs(\"cache\", exist_ok=True)\n",
    "\n",
    "\n",
    "def cached(path, fn):\n",
    "    if os.path.exists(path):\n",
    "        return joblib.load(path)\n",
    "    out = fn()\n",
    "    joblib.dump(out, path)\n",
    "    return out\n",
    "\n",
    "\n",
    "CRITERION = \"f1\"\n",
    "R = cached(f\"cache/modeles_R_{CRITERION}.joblib\",\n",
    "           lambda: {h: pipeline_horizon(raw, h, criterion=CRITERION) for h in HORIZONS})\n",
    "preds = pd.concat([predict_now(R[h], raw) for h in HORIZONS])"
   ]
  },
