    "#| echo: false\n",
    "import os\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import Image\n",
    "from sklearn.inspection import permutation_importance\n",
    "from sklearn.metrics import precision_score, recall_score, f1_score, precision_recall_curve\n",
    "\n",
    "from velib_utils import (load_raw_dt, prepare_sets, pipeline_horizon, evaluate_models,\n",
    "                         precision_at_recall, ablation, scored_frame, metrics_by, daily_dispersion,\n",
    "                         station_bootstrap, station_comparison, situation_table, pr_curves,\n",
    "                         correlated_pairs, seed_sensitivity, pca_val, plot_validation_summary,  \n",
    "                         SUSPECT_STATION, TZ,predict_now, summary_zone_test,plot_zone_test,\n",
    "                         plot_predictions_commune,top_alertes, map_predictions, map_predictions_folium)\n",
    "\n",
    "raw = load_raw_dt()\n",
    "HORIZONS = (30, 60)\n",
    "os.makedirs(\"cache\", exist_ok=True)\n",
    "\n",
    "\n",
    "def cached(path, fn):\n",
    "    \"\"\"Calcule fn() une seule fois et relit le résultat ensuite.\n",
    "    Supprimer le dossier cache/ après toute modification de velib_utils.py ou des données.\"\"\"\n",
    "    if os.path.exists(path):\n",
    "        return joblib.load(path)\n",
    "    out = fn()\n",
    "    joblib.dump(out, path)\n",
    "    return out\n",
    "\n",
    "\n",
    "CRITERION = \"f1\"                                  # doit être le même qu'en Partie 3\n",
    "CACHE = f\"cache/modeles_R_{CRITERION}.joblib\"     # même nom que la Partie 3\n",
    "R = cached(CACHE, lambda: {h: pipeline_horizon(raw, h, criterion=CRITERION) for h in HORIZONS})"
   ]
