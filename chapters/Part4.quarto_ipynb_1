    "#| code-fold: true\n",
    "# Prédictions sur le test : calculées une seule fois, puis relues depuis le cache\n",
    "TE = cached(f\"cache/TE_{CRITERION}.joblib\",\n",
    "            lambda: {h: evaluate_models(R[h], R[h][\"test\"]) for h in HORIZONS})       # (tableau, scores, seuils)\n",
    "COLS = [\"AP\", \"precision\", \"recall\", \"F1\", \"TP\", \"FP\", \"FN\", \"TN\"]\n",
    "\n",
    "for h in HORIZONS:\n",
    "    res, (table, sc, taus) = R[h], TE[h]\n",
    "    te = res[\"test\"]\n",
    "    chosen = res[\"chosen\"]\n",
    "    print(f\"horizon {h} min | {len(te)} lignes | taux de positifs : {te['y'].mean():.3f} | modèle retenu : {chosen}\")\n",
    "    display(table[COLS].round(3))\n",
    "    pers = table.loc[\"persistance\"]\n",
    "    at_recall = precision_at_recall(te[\"y\"], sc[chosen], pers[\"recall\"])\n",
    "    print(f\"Même rappel ({pers['recall']:.3f}) : précision {pers['precision']:.3f} pour la persistance \"\n",
    "          f\"contre {at_recall:.3f} pour {chosen}\")\n",
    "    print()"
   ]
