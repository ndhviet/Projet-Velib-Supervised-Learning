    "#| echo: false\n",
    "import branca.colormap as cm\n",
    "import folium\n",
    "\n",
    "# 1. Nettoyage et préparation des données\n",
    "df_map = (\n",
    "    raw.dropna(subset=[\"latitude\", \"longitude\"])\n",
    "    .groupby(\"station_code\", as_index=False)\n",
    "    .agg(\n",
    "        name=(\"name\", \"first\"),\n",
    "        commune=(\"commune\", \"first\"),\n",
    "        capacity=(\"capacity\", \"first\"),\n",
    "        latitude=(\"latitude\", \"first\"),\n",
    "        longitude=(\"longitude\", \"first\"),\n",
    "        bikes_available=(\"bikes_available\", \"mean\"),\n",
    "    )\n",
    ")\n",
    "print(\"Nombre de stations :\", len(df_map))\n",
    "\n",
    "# Conversion en format numérique pour un calcul précis des couleurs\n",
    "df_map[\"bikes_available\"] = df_map[\"bikes_available\"].astype(float)\n",
    "\n",
    "# 2. Création de la carte centrée sur Paris\n",
    "m = folium.Map(location=[48.8566, 2.3522], zoom_start=12, tiles=\"OpenStreetMap\")\n",
    "\n",
    "# 3. Création d'une échelle de couleurs très vive et contrastée\n",
    "min_bikes = df_map[\"bikes_available\"].min()\n",
    "max_bikes = df_map[\"bikes_available\"].max()\n",
    "if max_bikes == min_bikes:\n",
    "  max_bikes = min_bikes + 1\n",
    "\n",
    "# Palette de couleurs néon éclatante (du violet foncé au jaune vif)\n",
    "colormap = cm.LinearColormap(\n",
    "    colors=[\"#0d0887\", \"#6a00a8\", \"#b12a90\", \"#e16462\", \"#fca636\", \"#f0f921\"],\n",
    "    vmin=min_bikes,\n",
    "    vmax=max_bikes,\n",
    ")\n",
    "colormap.caption = \"Nombre moyen de vélos disponibles\"\n",
    "m.add_child(colormap)\n",
    "\n",
    "# 4. Ajout des stations sur la carte avec des marqueurs bien visibles et un contour noir\n",
    "for _, row in df_map.iterrows():\n",
    "  color = colormap(row[\"bikes_available\"])\n",
    "\n",
    "  popup_html = f\"\"\"\n",
    "    <b>{row['name']}</b><br>\n",
    "    <b>Code :</b> {row['station_code']}<br>\n",
    "    <b>Commune :</b> {row['commune']}<br>\n",
    "    <b>Capacité :</b> {row['capacity']}<br>\n",
    "    <b>Vélos dispo (moy) :</b> {row['bikes_available']:.1f}\n",
    "    \"\"\"\n",
    "\n",
    "  folium.CircleMarker(\n",
    "      location=[row[\"latitude\"], row[\"longitude\"]],\n",
    "      radius=8,  # Taille du cercle\n",
    "      color=\"#000000\",  # Contour noir pour faire ressortir chaque station\n",
    "      weight=1,\n",
    "      fill=True,\n",
    "      fill_color=color,\n",
    "      fill_opacity=0.9,\n",
    "      popup=folium.Popup(popup_html, max_width=300),\n",
    "  ).add_to(m)\n",
    "\n",
    "# 5. Affichage de la carte dans le notebook / Quarto\n",
    "m"
