    "#| code-fold: true\n",
    "# Une ligne par station, puis comptage par commune\n",
    "stations = raw.dropna(subset=[\"commune\"]).drop_duplicates(subset=\"station_code\")\n",
    "counts = (stations[\"commune\"].value_counts()\n",
    "          .rename_axis(\"commune\").reset_index(name=\"n_stations\"))\n",
    "\n",
    "fig = px.bar(\n",
    "    counts.sort_values(\"n_stations\"),\n",
    "    x=\"n_stations\", y=\"commune\", orientation=\"h\",\n",
    "    color_discrete_sequence=[\"#22C55E\"],\n",
    "    labels={\"n_stations\": \"Nombre de stations\", \"commune\": \"\"},\n",
    "    title=\"Nombre de stations par commune\",\n",
    "    height=max(400, 22 * len(counts)), )\n",
    "fig.show()"
   ]
