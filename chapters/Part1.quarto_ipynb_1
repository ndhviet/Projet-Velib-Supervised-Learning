    "# Nettoyage et agrégation des données"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "2a8a05c0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Nombre de stations : 80\n",
      "Période : 2026-08-25 13:57:26+02:00 -> 2026-10-08 22:15:01+02:00\n",
      "Nombre de jours : 45\n"
     ]
    }
   ],
   "source": [
    "#| code-fold: true\n",
    "TIME_COL = \"collected_at_utc\"\n",
    "\n",
    "df = raw.copy()\n",
    "df[\"ts\"] = pd.to_datetime(df[TIME_COL], errors=\"coerce\", utc=True).dt.tz_convert(\"Europe/Paris\")\n",
    "df = df.dropna(subset=[\"ts\", \"latitude\", \"longitude\"])\n",
    "df = df[(df[\"capacity\"] > 0) & (df[\"is_installed\"] == 1)].copy()\n",
    "\n",
    "df[\"hour\"] = df[\"ts\"].dt.hour\n",
    "df[\"weekday\"] = df[\"ts\"].dt.dayofweek\n",
    "df[\"periode\"] = np.where(df[\"weekday\"] >= 5, \"Week-end\", \"Semaine\")\n",
    "df[\"occupancy\"] = df[\"bikes_available\"] / df[\"capacity\"]\n",
    "\n",
    "stations = (\n",
    "    df.groupby(\"station_code\", as_index=False)\n",
    "      .agg(name=(\"name\", \"first\"), commune=(\"commune\", \"first\"),\n",
    "           capacity=(\"capacity\", \"first\"),\n",
    "           latitude=(\"latitude\", \"first\"), longitude=(\"longitude\", \"first\"),\n",
    "           bikes_available=(\"bikes_available\", \"mean\"),\n",
    "           occupancy=(\"occupancy\", \"mean\"))\n",
    ")\n",
    "\n",
    "print(\"Nombre de stations :\", len(stations))\n",
    "print(\"Période :\", df[\"ts\"].min(), \"->\", df[\"ts\"].max())\n",
    "print(\"Nombre de jours :\", df[\"ts\"].dt.date.nunique())"
   ]
